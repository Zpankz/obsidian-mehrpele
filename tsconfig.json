{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "ES2021.WeakRef", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "paths": {
      "mehrpele-api": ["./lib/mehrpele-api/index.ts"],
      "pele-render/canvas": ["./lib/pele-render/canvas/index.ts"],
      "pele-render/pele": ["./lib/pele-render/pele.ts"],
      "pele-render/node-size": ["./lib/pele-render/node-size/index.ts"],
      "pele-render/reflow": ["./lib/pele-render/reflow/index.ts"],
      "pele-render/repair": ["./lib/pele-render/repair/index.ts"],
      "pele-render/excalidraw": ["./lib/pele-render/excalidraw/index.ts"],
      "pele-render/extract": ["./lib/pele-render/extract.ts"]
    }
  },
  "include": ["main.ts", "src/**/*.ts", "lib/**/*.ts", "tests/**/*.ts"]
}
